# Copia este fichero a .env y rellena lo que tengas. El sistema funciona en
# modo demo sin ninguna de estas variables (python -m pump_signal run --demo).

# --- pump.fun (feed público de PumpPortal, no requiere key) ---
PUMPFUN_WS_URL=wss://pumpportal.fun/api/data

# --- X / Twitter (API v2, https://developer.x.com) ---
TWITTER_BEARER_TOKEN=

# --- Telegram (https://my.telegram.org, y ver README para generar la session string) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Canales/grupos públicos a escuchar, separados por coma (usernames o IDs)
TELEGRAM_CHANNELS=

# --- Noticias (opcional, https://cryptopanic.com/developers/api/) ---
CRYPTOPANIC_TOKEN=

# --- Notificaciones de alertas (opcional) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Comportamiento del orquestador ---
POLL_INTERVAL_SECONDS=30
ROLLING_WINDOW_MINUTES=60
CANDIDATE_TTL_MINUTES=180
TOP_N=5
MIN_MARKET_CAP_USD=3000
MAX_MARKET_CAP_USD=150000
DB_PATH=pump_signal.db
TRENDING_KEYWORDS=moon,100x,1000x,gem,ape,send it,next pepe,viral
